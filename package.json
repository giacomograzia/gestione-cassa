{
  "name": "nuova-cassa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Punto cassa web per sagre ed eventi: casse multiple, comande, monitor cucina, magazzino.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "import-legacy": "tsx server/import/legacy.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "4.3",
    "concurrently": "^9.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "5.4",
    "vitest": "^2.1.9"
  }
}
